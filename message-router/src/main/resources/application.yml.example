spring:
  application:
    name: message-router

  datasource:
    url: jdbc:h2:file:./data/message_db
    driver-class-name: org.h2.Driver
    username: ${DB_USERNAME:sa}
    password: ${DB_PASSWORD:password}

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    database-platform: org.hibernate.dialect.H2Dialect
    properties:
      hibernate:
        format_sql: true
    open-in-view: false

  security:
    oauth2:
      resourceserver:
        jwt:
          issuer-uri: ${KEYCLOAK_ISSUER_URI:http://localhost:8081/realms/spring-app}
          jwk-set-uri: ${KEYCLOAK_JWK_SET_URI:http://localhost:8081/realms/spring-app/protocol/openid-connect/certs}

  jms:
    pub-sub-domain: false
    listener:
      destination-name: ${MQ_INPUT_QUEUE:DEV.QUEUE.1}
      concurrency: 1
      max-concurrency: 5

server:
  port: ${SERVER_PORT:8085}

springdoc:
  api-docs:
    path: /api-docs
  swagger-ui:
    path: /swagger-ui.html
    url: /api-docs

ibm:
  mq:
    host: ${MQ_HOST:localhost}
    port: ${MQ_PORT:1414}
    queueManager: ${MQ_QUEUE_MANAGER:QM1}
    channel: ${MQ_CHANNEL:DEV.APP.SVRCONN}
    inputQueue: ${MQ_INPUT_QUEUE:DEV.QUEUE.1}
    user: ${MQ_USER_IBM}
    password: ${MQ_PASSWORD_IBM}

eureka:
  client:
    service-url:
      defaultZone: ${EUREKA_CLIENT_SERVICEURL_DEFAULTZONE:http://localhost:8761/eureka/}
